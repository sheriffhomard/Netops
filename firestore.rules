rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document
    match /test/connection {
      allow read: if true;
    }

    // Common security primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict verified owner: satisfies security_spec.md by enforcing verified email on mutations
    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    // Hardened Admin check: supports Custom Claims (admin == true), trusted /admins/ doc, and runtime owner
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'sheriffhomard@gmail.com' ||
          request.auth.token.admin == true ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'role', 'streakDays', 'lastStudyDate', 'precisionGlobal', 'labsCompleted', 'targetExam', 'studyHoursTotal', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.id == request.auth.uid &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 100)) &&
        (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0)) &&
        (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() <= 10)) &&
        (!('precisionGlobal' in data) || (data.precisionGlobal is number && data.precisionGlobal >= 0 && data.precisionGlobal <= 100)) &&
        (!('labsCompleted' in data) || (data.labsCompleted is number && data.labsCompleted >= 0)) &&
        (!('targetExam' in data) || (data.targetExam is string && data.targetExam.size() <= 100)) &&
        (!('studyHoursTotal' in data) || (data.studyHoursTotal is number && data.studyHoursTotal >= 0));
    }

    // Entity Validation: UserFlashcard
    function isValidUserFlashcard(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'front', 'back', 'module', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'front', 'back', 'module', 'certTrack', 'tags', 'difficulty', 'state', 'reviewCount', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.front is string && data.front.size() > 0 && data.front.size() <= 2000 &&
        data.back is string && data.back.size() > 0 && data.back.size() <= 4000 &&
        data.module is string && data.module.size() > 0 && data.module.size() <= 50 &&
        (!('certTrack' in data) || (data.certTrack is string && data.certTrack.size() <= 50)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('difficulty' in data) || (data.difficulty in ['Facile', 'Moyen', 'Difficile'])) &&
        (!('state' in data) || (data.state in ['new', 'learning', 'mastered'])) &&
        (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0));
    }

    // Entity Validation: ExamResult
    function isValidExamResult(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'examCode', 'score', 'passed', 'completedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'examCode', 'score', 'maxScore', 'passingScore', 'passed', 'durationSeconds', 'totalQuestions', 'correctAnswers', 'completedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.examCode is string && data.examCode.size() > 0 && data.examCode.size() <= 100 &&
        data.score is number && data.score >= 0 && data.score <= 1000 &&
        data.passed is bool &&
        (!('maxScore' in data) || (data.maxScore is number && data.maxScore >= 0)) &&
        (!('passingScore' in data) || (data.passingScore is number && data.passingScore >= 0)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0)) &&
        (!('totalQuestions' in data) || (data.totalQuestions is number && data.totalQuestions >= 0)) &&
        (!('correctAnswers' in data) || (data.correctAnswers is number && data.correctAnswers >= 0));
    }

    // Entity Validation: UserStudyNote
    function isValidUserStudyNote(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'content', 'category', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 10000 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    // User Profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if (isVerifiedOwner(userId) || isAdmin()) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isVerifiedOwner(userId) || isAdmin();

      // Subcollection: Flashcards
      match /flashcards/{flashcardId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isVerifiedOwner(userId) && isValidId(flashcardId) && isValidUserFlashcard(incoming(), userId);
        allow update: if isVerifiedOwner(userId) && isValidId(flashcardId) && isValidUserFlashcard(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().userId == existing().userId;
        allow delete: if isVerifiedOwner(userId) || isAdmin();
      }

      // Subcollection: Exam Results (immutable upon submission)
      match /examResults/{resultId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isVerifiedOwner(userId) && isValidId(resultId) && isValidExamResult(incoming(), userId);
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) || isAdmin();
      }

      // Subcollection: Engineering Study Notes
      match /notes/{noteId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isVerifiedOwner(userId) && isValidId(noteId) && isValidUserStudyNote(incoming(), userId);
        allow update: if isVerifiedOwner(userId) && isValidId(noteId) && isValidUserStudyNote(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().userId == existing().userId;
        allow delete: if isVerifiedOwner(userId) || isAdmin();
      }
    }
  }
}
